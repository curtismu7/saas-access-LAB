    {
      "name": "Preview an access request (mock)",
      "description": "e.preview(body.request) with {mode:'mock', request:{...}}. requestedBy must be the subject or the subject's manager (an agent's custodian); resource must be one of the platform's resource ids from /api/story.",
      "item": [
        {
          "name": "Preview a valid request (manager requests for engineer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Preview a valid request (manager requests for engineer)\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().preview.ok).to.eql(true);",
                  "  pm.expect(pm.response.json().preview.routing).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mode\": \"mock\",\n  \"request\": {\n    \"requestedBy\": \"priya.nair\",\n    \"subjectKind\": \"human\",\n    \"subjectId\": \"omar.reyes\",\n    \"platform\": \"github\",\n    \"resource\": \"gh-repo-core\",\n    \"level\": \"read\",\n    \"durationMin\": 30,\n    \"policyId\": \"pol-code-read\",\n    \"reason\": \"incident coverage\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{LAB_BASE}}/api/preview",
              "host": [
                "{{LAB_BASE}}"
              ],
              "path": [
                "api",
                "preview"
              ]
            },
            "description": ""
          },
          "response": []
        },
