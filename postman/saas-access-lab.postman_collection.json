{
  "info": {
    "name": "SaaS Access LAB",
    "description": "API collection for SaaS Access LAB: the zero-standing-access story across SaaS platforms (GitHub, GitLab, Salesforce, Snowflake, Databricks, Google Workspace). Preview a time-boxed access request against the approval routing (mock mode), and read the story catalog with its platforms, roles and honest field sources. The gateway check needs live mode (real_not_available in mock — the negative case).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "postman-saas-access-lab"
  },
  "item": [
    {
      "name": "Sanity (mock, labelled)",
      "description": "Health, mode info and the story catalog: platforms with their resources and levels, the approval roles, and the honest limits.",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Health\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().state).to.eql('ready');",
                  "});"
                ]
              }
            }
          ],
          "request": {
